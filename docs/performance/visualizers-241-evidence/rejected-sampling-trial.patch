+    @Test
+    fun sphereFrequencyContourInterpolatesAcrossTheAngularSeam() {
+        val bands = FloatArray(32)
+        bands[0] = .2f; bands[1] = .6f; bands[30] = .4f; bands[31] = .8f
+        val source = CommonShaderHeader + """
+            half4 main(float2 coord) {
+                float band = angularFrequencyAt((coord.x - 3.5) / 64.0);
+                return half4(band, band, band, 1.0);
+            }
+        """
+        val pixels = renderBands(source, bands, 6)
+        val expected = floatArrayOf(.6f, .8f, .5f, .2f, .4f, .6f)
+        expected.forEachIndexed { x, value ->
+            assertTrue(abs((pixels[x] and 255) - value * 255) <= 1, "angular seam at $x")
+        }
+    }
+
+    @Test
+    fun translatedFrequencySamplingMatchesLinearTextureCentersAndClampedEdges() {
+        val bands = FloatArray(32) { ((it * 13) % 32) / 31f }
+        val source = CommonShaderHeader + """
+            half4 main(float2 coord) {
+                float band = frequencyAt((coord.x - 2.5) / 64.0);
+                return half4(band, band, band, 1.0);
+            }
+        """
+        val pixels = renderBands(source, bands, 68)
+        repeat(pixels.size) { x ->
+            val column = ((x - 3) / 2f).coerceIn(0f, 31f)
+            val lower = column.toInt()
+            val upper = (lower + 1).coerceAtMost(31)
+            val expected = (bands[lower] + (bands[upper] - bands[lower]) * (column - lower)) * 255
+            assertTrue(abs((pixels[x] and 255) - expected) <= 1, "frequency sample at $x")
+        }
+    }
