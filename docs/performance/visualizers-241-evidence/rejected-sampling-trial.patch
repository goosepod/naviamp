+                builder.makeShader().use { shader ->
+                    Bitmap().use { bitmap ->
+                        assertTrue(bitmap.allocN32Pixels(width, 1))
+                        Paint().use { paint ->
+                            paint.shader = shader
+                            Canvas(bitmap).use { canvas -> canvas.drawRect(Rect.makeWH(width.toFloat(), 1f), paint) }
+                        }
+                        IntArray(width) { bitmap.getColor(it, 0) }
+                    }
+                }
+            }
+        }
+    }
