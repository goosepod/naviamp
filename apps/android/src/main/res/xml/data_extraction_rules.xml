<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="naviamp_android_credentials.xml" />
        <!-- Connect trust and resume secrets depend on Keystore keys that are never backed up. -->
        <exclude domain="sharedpref" path="naviamp-connect-trust.xml" />
        <exclude domain="sharedpref" path="naviamp-connect-session-credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="naviamp_android_credentials.xml" />
        <!-- Connect trust and resume secrets depend on Keystore keys that are never backed up. -->
        <exclude domain="sharedpref" path="naviamp-connect-trust.xml" />
        <exclude domain="sharedpref" path="naviamp-connect-session-credentials.xml" />
    </device-transfer>
</data-extraction-rules>
