CREATE TABLE IF NOT EXISTS library_genre_inventory_count (
  source_id TEXT NOT NULL,
  normalized_name TEXT NOT NULL,
  album_count INTEGER,
  track_count INTEGER,
  PRIMARY KEY(source_id, normalized_name),
  FOREIGN KEY(source_id, normalized_name)
    REFERENCES library_genre_inventory(source_id, normalized_name) ON DELETE CASCADE
);

-- Existing inventories predate provider counts. They are derived data, so clear
-- them once and let the next Genre Mix load repopulate them from the server.
DELETE FROM library_genre_inventory;
DELETE FROM library_genre_inventory_metadata;
